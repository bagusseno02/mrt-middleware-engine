# Generate different values: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-password
API_KEY=replace-with-a-random-api-key-of-at-least-32-characters
# Used by native execution and migration; Compose builds its own internal URL.
DATABASE_URL=postgres://pmcollector:replace-with-a-random-hex-password@localhost:5432/pmmonitor?sslmode=disable
